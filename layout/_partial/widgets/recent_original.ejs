<%
function layoutDiv() {
  var el = `<widget class="widget-wrapper${scrollreveal(' ')} recent post-list">`
  // header
  el += '<div class="widget-header dis-select">';
  el += '<span class="name">' + (item.title || __("meta.recent_update_post")) + '</span>';
  if (item.rss) {
    el += '<a class="cap-action" id="rss" title="Subscribe" href="' + item.rss + '">';
    el += icon('default:rss')
    el += '</a>';
  }
  el += '</div>';
  // body
  var arr = [];
  // 只取未绑定 topic 的普通文章
  arr = site.posts.filter(p => p.title && p.title.length > 0 && (!p.topic || p.topic.length === 0))
  arr = arr.sort("updated", -1)
  el += '<div class="widget-body fs14">'
  arr = arr.filter(p => p.title?.length > 0)
  arr.length = item.limit
  arr.forEach(post => {
    if (!post) { return }
    el += `<a class="item title" href="${pretty_url(post.link || post.path)}">`
    el += '<span class="title">'
    el += post.title + '</span>';
    el += '</a>';
    el += '';
  });
  el += '</div>';
  el += '</widget>';
  return el;
}
%>
<%- layoutDiv() %>
