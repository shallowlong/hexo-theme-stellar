<%
function layoutDiv() {
  var action = ''
  if (item.rss) {
    action += '<a class="cap-action" id="rss" title="Subscribe" href="' + escape_html(item.rss) + '">'
    action += icon('default:rss')
    action += '</a>'
  }
  var arr = []
  // 只取未绑定 topic 的普通文章
  arr = site.posts.filter(p => p.title && p.title.length > 0 && (!p.topic || p.topic.length === 0))
  arr = arr.sort("updated", -1)
  arr = arr.filter(p => p.title?.length > 0)
  arr.length = item.limit
  var entries = []
  arr.forEach(post => {
    if (!post) { return }
    entries.push({
      href: pretty_url(post.link || post.path),
      title: post.title,
      indicator: false
    })
  })
  var body = partial('_partial/components/collection', {options: {
    layout: 'list',
    variant: 'nav',
    density: 'compact',
    items: entries
  }})
  return partial('_partial/components/widget-frame', {
    className: 'recent-widget',
    title: __('meta.recent_update_post'),
    action: action,
    body: body
  })
}
%>
<%- layoutDiv() %>
